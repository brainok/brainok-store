# Copy relevant values into firebase-functions/.env and app/web .env files.

# Firebase client config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set with:
# firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=

# Optional non-secret sender identity for Resend.
# Use a verified Resend domain before production sending.
RESEND_FROM_EMAIL="Brainok Licensing <licenses@brainok.net>"
RESEND_REPLY_TO_EMAIL=brainok777@gmail.com

# Future Toss Payments settings should be added behind the PaymentProvider layer.
TOSS_PAYMENTS_CLIENT_KEY=
